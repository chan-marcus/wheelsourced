---
import { loadWheels } from "../lib/data.js";
import "../styles/global.css";

export async function getStaticPaths() {
  const wheels = loadWheels();
  return wheels.map((wheel) => ({
    params: { wheel: wheel.slug },
    props: { wheel },
  }));
}

const { wheel } = Astro.props;

// Where the supplier suggestion posts. Same arrangement as the wheel request
// form on the index: the local GUI in dev, a same-origin Pages Function in a
// build. Never a hardcoded localhost URL, which is unreachable from a
// visitor's machine and blocked as mixed content from https regardless.
const SUGGEST_ENDPOINT =
  import.meta.env.PUBLIC_SUGGEST_ENDPOINT ||
  (import.meta.env.DEV ? "http://localhost:8420/api/suggest-supplier" : "/api/suggest-supplier");

const refSpec = wheel.suppliers.find((s) => s.ref_spec)?.ref_spec ?? "18x9.5J ET+22 5x114.3";
const refSize = refSpec.split(" ")[0] ?? "18x9.5J";
const quoted = wheel.suppliers.filter((s) => s.replies).length;
// Flags never reach the browser. They are internal sourcing judgements, and
// several read as accusations against a named real company ("cert claimed, no
// document"). Removing them from the rendered tags left them sitting in this
// payload in plain sight of View Source, which is not hidden at all on a
// public domain. Ship only what the page needs: whether the vendor is clean,
// for the "top" badge.
const payload = JSON.stringify({
  suppliers: wheel.suppliers.map(({ flags, ...s }) => ({ ...s, clean: !flags.length })),
});
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>WheelSourced - {wheel.title.toUpperCase()}</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
<div class="sheet">

  <header class="masthead">
    <a class="logo" href="/" aria-label="WheelSourced home">
      <span class="word">Wheel<em>Sourced</em></span>
    </a>
    <div class="eyebrow" style="display: flex; gap: 16px; align-items: flex-start; justify-content: space-between; width: 100%;">
      <span style="font-size: 28px; font-weight: 700; flex: 1;">{wheel.title}<span style="font-size: 0.6em;">-style</span></span>
      <span style="text-align: right; white-space: nowrap;">{wheel.suppliers.length} suppliers tracked</span>
    </div>
  </header>

  <div class="preamble">
    <p><b>Every shop here builds to order.</b> You choose diameter, width, offset and finish when you contact them, so there is nothing to filter. What matters is which vendor is worth talking to.</p>
    <p class="est">Pricing is a <b>like-for-like estimate quoted at 18x9.5J</b>, asked of every vendor with the same spec so the figures compare. Your own size and lip depth will move it. Treat this as a ranking, not a quote. Shipping costs are based on quotes to Los Angeles, CA.</p>
  </div>

  <section class="block">
    <div class="band">Suppliers
      <span>
        <label class="sortlbl" for="sort">sort</label>
        <select id="sort">
          <option value="vetting">best vetted</option>
          <option value="price">cheapest</option>
          <option value="rating">store rating</option>
          <option value="age">store age</option>
          <option value="response">fastest response</option>
          <option value="reorder">reorder rate</option>
        </select>
        <b id="count"></b>
      </span>
    </div>
    <div id="rows"></div>
  </section>

  <section style="margin-top: 48px; padding: 28px 20px; border: 1px solid var(--ink); text-align: center;">
    <h2 style="font-family: 'Barlow Condensed'; font-size: 22px; font-weight: 700; text-transform: uppercase; margin: 0 0 8px;">Know a factory we have missed?</h2>
    <p style="max-width: 560px; margin: 0 auto 16px; color: var(--soft);">Send an Alibaba or 1688 listing making this wheel and it joins the vetting queue. Suggestions are not published until they have been through the same questions as everything above.</p>
    <button class="btn" id="sgopen">Suggest a supplier</button>
  </section>

  <footer style="margin-top: 60px; padding: 40px 20px; border-top: 1px solid var(--ink); color: var(--soft);">
    <div style="max-width: 900px; margin-left: auto; margin-right: auto;">
      <p>Store rating, response time, store age, reorder rate and transit time are the platform's own figures, not vendor claims. Reorder rate is the most telling: it is the share of buyers who came back.</p>
      <p>Best vetted is scored out of 100 and combines landed cost, store rating, store age, review count, response time, reorder rate and transit time. It is scaled by how many of those a vendor actually has, so a thin record cannot outrank a complete one on a lucky average. Expect real numbers in the 40s to 60s: 100 means excellent on every axis at once, which no supplier here is.</p>
      <p>A rating counts for as much as its sample supports: 5.0 from two buyers is not a better rating than 4.8 from eighty-seven, only a less certain one, so ratings are weighted by review count before scoring. Every axis except price is judged against a fixed standard rather than against the other vendors, because a shop with one year and two reviews is thin whether or not a rival is thinner, and a 20% reorder rate is respectable whether or not someone else hit 46%. Price is the exception: these are like-for-like quotes at one reference spec, so the cheapest genuinely is the best price on offer. Only a fully quoted landed cost is scored, so withholding freight cannot make a vendor look cheap.</p>
      <p>Grey figures come from the listing. Black figures were quoted directly. Blank means asked and not answered.</p>
      <p>Wheels are described by construction and geometry, never as another maker's product.</p>
    </div>
    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--ink); text-align: center; font-family: 'IBM Plex Mono'; font-size: 11px;">
      © 2026 WheelSourced. Specs and supplier data updated quarterly.
    </div>
  </footer>
</div>

<div id="modal" class="modal" hidden>
  <div class="modalbox" role="dialog" aria-modal="true" aria-labelledby="mtitle">
    <div class="mhead"><span id="mtitle">Your spec</span>
      <button class="x" id="mclose" aria-label="Close">×</button></div>
    <p class="mhint">Your spec and location will be filled into the message.</p>
    <div class="mgrid">
      <div><label for="m-car">Car (make, model, year)</label><input id="m-car" placeholder="BMW E36 325i, 1995" /></div>
      <div><label for="m-dia">Diameter</label><input id="m-dia" placeholder="18" /></div>
      <div><label for="m-wid">Width</label><input id="m-wid" placeholder="9.5J" /></div>
      <div><label for="m-off">Offset</label><input id="m-off" placeholder="ET+22" /></div>
      <div><label for="m-pcd">Bolt pattern</label><input id="m-pcd" placeholder="5x120" /></div>
      <div><label for="m-pieces">Construction</label><select id="m-pieces" style="width: 100%; padding: 8px 10px; border: 1px solid #A9AFA5; font-family: 'IBM Plex Mono'; font-size: 13px; background: transparent; color: inherit; appearance: auto;"><option value="">Select</option><option value="single-piece">Single Piece</option><option value="2-piece">2-Piece</option><option value="3-piece">3-Piece</option></select></div>
      <div><label for="m-finish">Finish / color</label><input id="m-finish" placeholder="Polished silver, bronze, etc." /></div>
      <div><label for="m-zip">Shipping zip code</label><input id="m-zip" placeholder="90210" /></div>
    </div>
    <div class="mfoot">
      <button class="btn" id="mcopy">Copy message</button>
      <button class="btn ghost" id="mskip">Copy without spec</button>
    </div>
    <textarea id="mpreview" spellcheck="false" aria-label="Message preview"></textarea>
  </div>
</div>

<div id="sgmodal" class="modal" hidden>
  <div class="modalbox" role="dialog" aria-modal="true" aria-labelledby="sgtitle" style="max-width:520px;">
    <div class="mhead"><span id="sgtitle">Suggest a supplier</span>
      <button class="x" id="sgclose" aria-label="Close">×</button></div>
    <p class="mhint">An Alibaba or 1688 listing for this wheel. We do the vetting, so the listing is a starting point rather than a recommendation.</p>
    <form id="sgform" data-endpoint={SUGGEST_ENDPOINT} data-wheel={wheel.slug}>
      <div class="mgrid">
        <div><label for="sg-url">Listing URL</label>
          <input id="sg-url" type="url" required placeholder="https://www.alibaba.com/product-detail/..." /></div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;margin-top:14px;">
        <input id="sg-alert" type="checkbox" style="width:16px;height:16px;cursor:pointer;" />
        <label for="sg-alert" style="font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;margin:0;">Alert me when it is vetted</label>
      </div>
      <div id="sg-emailfield" class="mgrid" style="display:none;margin-top:12px;">
        <div><label for="sg-email">Email</label>
          <input id="sg-email" type="email" placeholder="you@example.com" />
          <div style="font-family:'IBM Plex Mono';font-size:11px;color:var(--soft);margin-top:6px;">Used once, to tell you the verdict on this listing.</div></div>
      </div>
      <div id="sg-error" role="alert" style="display:none;font-family:'IBM Plex Mono';font-size:11.5px;color:var(--chop);border:1px solid var(--chop);padding:8px 10px;margin-top:14px;"></div>
      <div class="mfoot"><button class="btn" type="submit">Send suggestion</button></div>
    </form>
  </div>
</div>

<div id="sgconfirm" hidden style="position:fixed;top:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--stock);padding:14px 22px;font-family:'IBM Plex Mono';font-size:12.5px;z-index:2000;max-width:90%;text-align:center;">
  Suggestion received. It goes into the vetting queue.
</div>

<script id="data" type="application/json" set:html={payload}></script>
<script is:inline>
const D = JSON.parse(document.getElementById("data").textContent);
const el = (id) => document.getElementById(id);
let sortMode = "vetting";
let current = null;

const money = (n) => "$" + Math.round(n).toLocaleString();
// "4 pieces" -> "4". The Min. order label already says what is being counted.
// Only piece/pieces: a "2 sets" MOQ means something different from "2" and
// keeps its unit. Display only, because s.moq is compared as a whole string
// above to decide whether a per-wheel figure is meaningful.
const moqCount = (v) =>
  typeof v === "string" ? v.replace(/\s*pieces?\b\.?/i, "").trim() || v : v;
// Whether the certificate itself ever arrived, shown grey beside the names
// because it qualifies them rather than answering for them. "DOT, VIA" with
// nothing attached is a claim, and the sheet has to keep saying so.
//
// Short forms only when they follow the names, where "claimed" would just
// repeat the names being right there. Standing alone the stored phrase is
// left long, because it has to describe itself: a bare "no document" would
// not say that a certification was claimed at all.
const CERT_DOC = {
  "provided": "on file",
  "promised": "promised",
  "claimed without document": "no document",
  "not available": "none available",
};
const certDoc = (v) =>
  v ? ` <span class="grey">${CERT_DOC[v] || v}</span>` : "";

// Standing alone the stored phrase is usually self-describing, so it is used
// as it is. "not available" is the exception: printed raw it sits one word
// away from the "not disclosed" that means the supplier never answered, and a
// supplier who told us they have no certificate must not read like one who
// ignored the question.
const CERT_DOC_ALONE = { "not available": "none available" };
const certAlone = (v) => (v ? CERT_DOC_ALONE[v] || v : null);
const or = (v, unit = "") =>
  v === null || v === undefined || v === ""
    ? `<span class="none">not disclosed</span>` : `${v}${unit}`;

el("sort").addEventListener("change", (e) => { sortMode = e.target.value; render(); });

// Which spec panels are expanded. Held outside render() because changing the
// sort rebuilds every row, and silently closing the panel you were reading is
// the kind of thing that makes a sheet feel unreliable.
const open = new Set();

function setOpen(article, id, want) {
  const specs = el(`specs-${id}`);
  if (!specs) return;
  want ? open.add(id) : open.delete(id);
  // Smooth collapse/expand with CSS transitions. max-height + opacity for
  // smooth reveal without display:none which kills animations.
  // requestAnimationFrame ensures the browser calculates the scrollHeight
  // before the transition starts, so the animation runs smoothly.
  requestAnimationFrame(() => {
    specs.style.maxHeight = want ? (specs.scrollHeight + 8) + "px" : "0";
    specs.style.opacity = want ? "1" : "0";
  });
  specs.style.overflow = "hidden";
  specs.style.transition = `max-height 250ms cubic-bezier(0.4,0,0.2,1), opacity 250ms cubic-bezier(0.4,0,0.2,1)`;
  // Write the label into the toggle button, found from the row. The old code
  // used event.target, so clicking the headline replaced whichever stat cell
  // you happened to hit with the words "Hide details" and lost the figure.
  const btn = article.querySelector("[data-toggle-btn]");
  if (btn) {
    btn.textContent = want ? "Hide details" : "Show details";
    btn.setAttribute("aria-expanded", want);
  }
}

function ordered() {
  const l = D.suppliers.slice();
  const by = (get, dir) => l.sort((a, b) => {
    const av = get(a), bv = get(b);
    if (av == null && bv == null) return b.answered - a.answered;
    if (av == null) return 1;
    if (bv == null) return -1;
    return dir * (av - bv);
  });
  switch (sortMode) {
    case "price":    return by((s) => s.landed ?? s.setPrice, 1);
    case "rating":   return by((s) => s.store_rating, -1);
    case "age":      return by((s) => s.years, -1);
    case "response": return by((s) => s.respHours, 1);
    case "reorder":  return by((s) => s.reorderPct, -1);
    default:         return by((s) => s.vetScore, -1);
  }
}

function render() {
  const hit = ordered();
  el("count").textContent = `${hit.length} suppliers`;

  el("rows").innerHTML = hit.map((s, i) => `
    <article class="v ${sortMode === "vetting" && i === 0 && s.clean ? "top" : ""}">
      <div class="vh">
        <div class="vinfo">
          <div class="vn">${s.name}</div>
          <div class="vm" style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;">
            ${s.verified ? `<span class="tag good">verified supplier</span>` : ""}
            ${s.business_type ? `<span class="tag">${s.business_type}</span>` : ""}
            <span class="tag">${s.forged === true ? "forged" : s.forged === false ? "not forged" : "forging unconfirmed"}</span>
            ${Array.isArray(s.pieces) ? s.pieces.map(p => `<span class="tag">${p}</span>`).join("") : `<span class="tag">${s.pieces || "piece count unknown"}</span>`}
          </div>
        </div>
        <div class="vp">
          ${s.landed
            ? `<b>${money(s.landed)}</b><small>est. landed / set of 4</small>`
            : s.setPrice
              ? `<b>${money(s.setPrice)}</b><small>set of 4, before freight</small>
                 <small class="warnsm">freight not quoted</small>`
              : `<b class="grey">${s.listed_price ? money(s.listed_price * 4) : "—"}</b>
                 <small>listed only, not quoted</small>`}
        </div>
      </div>

      <div class="headline" data-toggle="${s.id}" style="cursor: pointer;">
        <div class="${sortMode === "rating" ? "hl on" : "hl"}">
          <dt>Store rating</dt><dd>${s.store_rating ? s.store_rating + "/5" : "—"}
          ${s.review_count ? `<em>(${s.review_count})</em>` : ""}</dd></div>
        <div class="${sortMode === "age" ? "hl on" : "hl"}">
          <dt>Store age</dt><dd>${s.years ? s.years + (s.years === 1 ? " yr" : " yrs") : "—"}</dd></div>
        <div class="${sortMode === "response" ? "hl on" : "hl"}">
          <dt>Response</dt><dd>${s.response_time ?? "—"}</dd></div>
        <div class="${sortMode === "reorder" ? "hl on" : "hl"}">
          <dt>Reorder rate</dt><dd>${s.reorder ?? "—"}</dd></div>
        <div class="hl">
          <dt>Est. transit</dt><dd>${s.transit ? s.transit.replace(/^Est\.\s*/, "") : "—"}</dd></div>
        <div class="${sortMode === "vetting" ? "hl on" : "hl"}">
          <dt>Vetting score</dt><dd>${s.vetScore ?? "—"}<em>/100</em></dd></div>
      </div>

      <div style="margin-top: 12px;">
        <button class="btn ghost" data-toggle="${s.id}" data-toggle-btn
          aria-controls="specs-${s.id}" aria-expanded="${open.has(s.id)}"
          >${open.has(s.id) ? "Hide details" : "Show details"}</button>
        <dl class="specs" id="specs-${s.id}"
          style="margin-top:12px;max-height:${open.has(s.id) ? "999px" : "0"};opacity:${open.has(s.id) ? "1" : "0"};overflow:hidden;transition:max-height 250ms cubic-bezier(0.4,0,0.2,1), opacity 250ms cubic-bezier(0.4,0,0.2,1);">
          <div><dt>Per wheel</dt><dd>${
            s.moq === "1 piece" && s.setPrice ? money(s.setPrice / 4)
            : s.listed_price ? `<span class="grey">${money(s.listed_price)} listed</span>`
            : or(null)}</dd></div>
          <div><dt>Forged</dt><dd>${s.forged === true ? "confirmed"
            : s.forged === false ? "no" : or(null)}</dd></div>
          <div><dt>Process stated</dt><dd>${or(s.forging_process)}</dd></div>
          <div><dt>Pieces</dt><dd>${or(s.pieces)}</dd></div>
          <div><dt>Certification</dt><dd>${
            s.certs ? s.certs.join(", ") + certDoc(s.cert) : or(certAlone(s.cert))}</dd></div>
          <div><dt>Heat treat</dt><dd>${or(s.heat_treat)}</dd></div>
          <div><dt>CNC</dt><dd>${s.cnc === true ? "in house"
            : s.cnc === false ? "outsourced" : or(null)}</dd></div>
          <div><dt>Payment terms</dt><dd>${or(s.payment)}</dd></div>
          <div><dt>Damage/Defect policy</dt><dd>${or(s.defects)}</dd></div>
          <div><dt>Est. Shipping Cost</dt><dd>${s.freight ? money(s.freight) : or(null)}</dd></div>
          <div><dt>Min. order</dt><dd>${or(moqCount(s.moq))}</dd></div>
        </dl>
      </div>

      <div class="vf" style="margin-top:12px;">
        <button class="btn" data-rfq="${s.id}">Write quote request</button>
        ${s.url ? `<a class="btn ghost" href="${s.url}" rel="nofollow noopener" target="_blank">Open listing</a>` : ""}
        <span class="seen">${s.verified_on ? "last verified " + s.verified_on : ""}</span>
      </div>
    </article>`).join("");
}

el("rows").addEventListener("click", (e) => {
  const t = e.target.closest("[data-toggle]");
  if (!t) return;
  const id = t.dataset.toggle;
  setOpen(t.closest(".v"), id, !open.has(id));
});

document.addEventListener("click", (e) => {
  const b = e.target.closest("[data-rfq]");
  if (!b) return;
  current = D.suppliers.find((x) => x.id === b.dataset.rfq);
  el("mtitle").textContent = "Your spec for " + current.name;
  el("modal").hidden = false;
  refresh();
  el("m-car").focus();
});

function buildMsg(s, spec) {
  const carline = spec?.car ? `My car: ${spec.car}\n\n` : "";
  const lines = spec
    ? [["Diameter", spec.dia], ["Width", spec.wid],
       ["Offset", spec.off], ["Bolt pattern", spec.pcd], ["Construction", spec.pieces], ["Finish", spec.finish]]
        .filter(([, v]) => v).map(([k, v]) => `  ${k.padEnd(13)}${v}`).join("\n")
    : "  Diameter      __\n  Width         __\n  Offset        __\n  Bolt pattern  __\n  Construction  __\n  Finish        __";

  const zipline = spec?.zip ? `\n\nShipping zip code: ${spec.zip}` : "";

  const ask = [];
  ask.push("Price per wheel (1 set of 4 wheels and for 4 sets if available)");
  ask.push("Shipping cost to the zip code above");

  return `Hello,

${carline}I'm interested in your wheels and would like a quote for this spec:

${lines}${zipline}

Could you please provide:
${ask.map((q, i) => `  ${i + 1}. ${q}`).join("\n")}

Thank you.`;
}

const readSpec = () => ({
  car: el("m-car").value.trim(),
  dia: el("m-dia").value.trim(),
  wid: el("m-wid").value.trim(),
  off: el("m-off").value.trim(),
  pcd: el("m-pcd").value.trim(),
  pieces: el("m-pieces").value.trim(),
  finish: el("m-finish").value.trim(),
  zip: el("m-zip").value.trim(),
});

function refresh() { el("mpreview").value = buildMsg(current, readSpec()); }

["m-car","m-dia","m-wid","m-off","m-pcd","m-pieces","m-finish","m-zip"].forEach((id) =>
  el(id).addEventListener("input", refresh));

const close = () => { el("modal").hidden = true; };
el("mclose").addEventListener("click", close);
el("modal").addEventListener("click", (e) => { if (e.target.id === "modal") close(); });

// Suggest a supplier. Same shape as the RFQ modal above so the two behave
// identically, and the endpoint arrives on a data attribute for the reason
// documented on the index form: define:vars would close over the handler.
const sgform = el("sgform");
const SUGGEST_ENDPOINT = sgform.dataset.endpoint;
const SUGGEST_WHEEL = sgform.dataset.wheel;

const closeSuggest = () => { el("sgmodal").hidden = true; };
el("sgopen").addEventListener("click", () => {
  el("sg-error").style.display = "none";
  el("sgmodal").hidden = false;
  el("sg-url").focus();
});
el("sgclose").addEventListener("click", closeSuggest);
el("sgmodal").addEventListener("click", (e) => { if (e.target.id === "sgmodal") closeSuggest(); });

// The address field only exists once they have asked to be alerted, and
// clearing it on uncheck means an unticked box never sends an address.
el("sg-alert").addEventListener("change", (e) => {
  const field = el("sg-emailfield");
  field.style.display = e.target.checked ? "grid" : "none";
  if (e.target.checked) el("sg-email").focus();
  else el("sg-email").value = "";
});

sgform.addEventListener("submit", async (e) => {
  e.preventDefault();
  const url = el("sg-url").value.trim();
  if (!url) return;

  const btn = sgform.querySelector('button[type="submit"]');
  const label = btn.textContent;
  const err = el("sg-error");
  err.style.display = "none";
  btn.textContent = "Sending..."; btn.disabled = true;

  try {
    const res = await fetch(SUGGEST_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        url,
        wheel: SUGGEST_WHEEL,
        email: el("sg-alert").checked ? el("sg-email").value.trim() || null : null,
      }),
    });
    // Read the body before throwing: the endpoint explains a rejected URL,
    // and "Server returned 400" would hide the one thing worth saying.
    const body = await res.json().catch(() => ({}));
    if (!res.ok || !body.ok) throw new Error(body.error || "Server returned " + res.status);

    sgform.reset();
    el("sg-emailfield").style.display = "none";
    closeSuggest();
    const ok = el("sgconfirm");
    ok.hidden = false;
    setTimeout(() => { ok.hidden = true; }, 3000);
  } catch (e2) {
    // Never fail silently. A closed modal with no banner is indistinguishable
    // from success, which is how the index form used to lose submissions.
    err.textContent = e2.message || "Could not send that suggestion. Please try again.";
    err.style.display = "block";
  } finally {
    btn.textContent = label; btn.disabled = false;
  }
});

document.addEventListener("keydown", (e) => {
  if (e.key !== "Escape") return;
  close();
  closeSuggest();
});

async function copy(txt, btn, label) {
  try { await navigator.clipboard.writeText(txt); btn.textContent = "Copied"; }
  catch { el("mpreview").select(); btn.textContent = "Press ⌘C"; }
  setTimeout(() => (btn.textContent = label), 2000);
}
el("mcopy").addEventListener("click", (e) => copy(buildMsg(current, readSpec()), e.target, "Copy message"));
el("mskip").addEventListener("click", (e) => copy(buildMsg(current, null), e.target, "Copy without spec"));

render();
</script>
</body>
</html>
