---
import { loadWheels } from "../lib/data.js";
import "../styles/global.css";

const wheels = loadWheels();
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>WheelSourced</title>
<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
<style>
  .landing {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
  }
  .landing-content {
    max-width: 800px;
    text-align: center;
    margin-bottom: 60px;
  }
  .landing h1 {
    font-family: 'Barlow Condensed';
    font-size: clamp(48px, 10vw, 96px);
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .landing h1 em {
    font-style: normal;
    color: var(--bronze);
  }
  .landing p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--soft);
    margin: 0 0 40px;
  }
  .wheels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    max-width: 1200px;
    margin: 40px auto 0;
  }
  @media (max-width: 1024px) {
    .wheels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .wheels-grid {
      grid-template-columns: 1fr;
    }
  }
  .wheel-card {
    border: 2px solid var(--ink);
    padding: 32px 24px;
    background: transparent;
    transition: background var(--trans-smooth),transform var(--trans-smooth),box-shadow var(--trans-smooth);
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    text-align: center;
  }
  .wheel-image {
    width: 125px;
    height: 125px;
    object-fit: contain;
    margin-bottom: 12px;
    transition: transform var(--trans-smooth);
    /* No background of its own. The card is transparent at rest and --stock2
       on hover, so a fixed --stock matte behind the wheel matched the page
       until the card darkened and then sat there as a pale square. A
       transparent PNG should take whatever is behind it. The radius stays for
       a future wheel shot that is an opaque photo rather than line art. */
    border-radius: 4px;
  }
  .wheel-card:hover {
    background: var(--stock2);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  .wheel-card:hover .wheel-image {
    transform: scale(1.05);
  }
  .wheel-card h2 {
    font-family: 'Barlow Condensed';
    font-size: 28px;
    font-weight: 700;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .wheel-card .meta {
    font-family: 'IBM Plex Mono';
    font-size: 12px;
    color: var(--soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .wheel-card .count {
    font-family: 'IBM Plex Mono';
    font-size: 13px;
    color: var(--ink);
    margin-top: 8px;
  }
  .wheel-card a {
    display: inline-block;
    font-family: 'IBM Plex Mono';
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 9px 14px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--stock);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 12px;
    text-align: center;
  }
  .wheel-card a:hover {
    background: var(--stock);
    color: var(--ink);
  }
  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }
  .empty-state p {
    font-size: 18px;
    color: var(--soft);
    margin: 20px 0;
  }
</style>
</head>
<body>
<div class="sheet landing">
  <header class="masthead" style="width: 100%; max-width: 900px; margin-bottom: 40px;">
    <a class="logo" href="/" aria-label="WheelSourced home">
      <span class="word">Wheel<em>Sourced</em></span>
    </a>
  </header>

  <div class="landing-content">
    <h1>Wheel<em>Sourced</em></h1>
  </div>

  {wheels.length > 0 ? (
    <div class="wheels-grid">
      {wheels.map((wheel) => (
        <div class="wheel-card">
          {wheel.hasImage && (
            <img
              class="wheel-image"
              src={`/wheels/${wheel.slug}/image${wheel.imageExt}`}
              alt={wheel.title}
            />
          )}
          <h2>{wheel.title}<span style="font-size: 0.65em;">-style</span></h2>
          <div class="count">
            {wheel.suppliers.length} suppliers
          </div>
          <a href={`/${wheel.slug}/`}>View sourcing sheet</a>
        </div>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h2>No wheels yet</h2>
      <p>Add wheel data by running the pipeline and refresh this page.</p>
    </div>
  )}

  <div class="landing-content" style="margin-top: 80px; margin-bottom: 40px;">
    <p style="font-size: 18px; color: var(--soft);">Don't see a wheel you're interested in?</p>
    <a href="/request" style="display: inline-block; font-family: 'IBM Plex Mono'; font-size: 11.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 9px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--stock); text-decoration: none; transition: all 0.2s;">Request here</a>
  </div>

  <footer style="margin-top: 120px; padding: 40px 20px; border-top: 1px solid var(--ink); text-align: center; color: var(--soft);">
    <p style="font-family: 'IBM Plex Mono'; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 12px;">
      WheelSourced © 2026.
    </p>
    <p style="font-size: 13px; margin: 0; max-width: 600px; margin-left: auto; margin-right: auto;">
      A curated sourcing site for aftermarket wheels made by Chinese factories.
    </p>
  </footer>
</div>

</body>
</html>
