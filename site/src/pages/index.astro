---
import { loadWheels } from "../lib/data.js";
import "../styles/global.css";

const wheels = loadWheels();

// Where the request form posts. In dev that is the local GUI on :8420, which
// writes wheel_requests.json. In a build it is same-origin, handled by the
// Pages Function in site/functions/api/. The old code hardcoded the localhost
// URL, so on a public domain every submission failed: the host is not
// reachable from a visitor's machine, and a browser blocks an http call from
// an https page as mixed content regardless.
const REQUEST_ENDPOINT =
  import.meta.env.PUBLIC_REQUEST_ENDPOINT ||
  (import.meta.env.DEV ? "http://localhost:8420/api/request-wheel" : "/api/request-wheel");

const canonical = new URL("/", Astro.site).href;
const supplierCount = wheels.reduce((n, w) => n + w.suppliers.length, 0);
const description =
  `Independent vetting of Chinese factories making forged aftermarket wheels. ` +
  `${supplierCount} suppliers quoted at one reference spec, with prices ` +
  `published as given.`;

// Organization only, and only facts that are true. No aggregateRating, no
// invented founding date, no social profiles that do not exist: schema is
// read by machines that have no way to check, which is exactly why putting
// anything unverifiable in it is a bad habit to start.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "WheelSourced",
  url: canonical,
  logo: new URL("/favicon-192.png", Astro.site).href,
  description:
    "A curated sourcing site for aftermarket wheels made by Chinese factories.",
};
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Tells the browser this page already handles its own theming, so a
     browser-level "force dark mode for sites that don't support it" feature
     has no reason to step in and re-theme an already-dark page. Also switches
     native form controls (date pickers, checkboxes, scrollbars) to their dark
     rendering instead of a jarring light default. -->
<meta name="color-scheme" content="dark" />
<title>WheelSourced</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="WheelSourced" />
<!-- og:title mirrors the title element rather than writing a better one of
     its own, so the two cannot say different things about the same page. -->
<meta property="og:title" content="WheelSourced" />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL("/favicon-192.png", Astro.site).href} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="WheelSourced" />
<meta name="twitter:description" content={description} />
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
<style>
  .landing {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2.5rem 1.25rem;
  }
  .landing-content {
    max-width: 50rem;
    text-align: center;
    margin-bottom: 3.75rem;
  }
  /* The h1 is the hero now that the wordmark repeat is gone, so it takes the
     display size the wordmark had rather than sitting under it as a subhead. */
  .landing h1 {
    font-family: 'Barlow Condensed';
    font-size: clamp(2.375rem, 7vw, 4.25rem);
    font-weight: 700;
    margin: 0 0 1.5rem;
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .landing p.lede {
    font-size: 1rem;
    max-width: 38.75rem;
    margin-left: auto;
    margin-right: auto;
  }
  .landing p.lede a {
    display: inline-block;
    margin-top: .5rem;
    color: var(--bronze);
    font-family: 'IBM Plex Mono';
    font-size: .71875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .landing p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--soft);
    margin: 0 0 2.5rem;
  }
  .wheels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
    max-width: 75rem;
    margin: 2.5rem auto 0;
  }
  @media (max-width: 1024px) {
    .wheels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .wheels-grid {
      grid-template-columns: 1fr;
    }
  }
  .wheel-card {
    border: 2px solid var(--ink);
    padding: 2rem 1.5rem;
    background: transparent;
    transition: background var(--trans-smooth),transform var(--trans-smooth),box-shadow var(--trans-smooth);
    display: flex;
    flex-direction: column;
    gap: .75rem;
    align-items: center;
    text-align: center;
  }
  .wheel-image {
    width: 7.8125rem;
    height: 7.8125rem;
    object-fit: contain;
    margin-bottom: .75rem;
    transition: transform var(--trans-smooth);
    /* No background of its own. The card is transparent at rest and --stock2
       on hover, so a fixed --stock matte behind the wheel matched the page
       until the card darkened and then sat there as a pale square. A
       transparent PNG should take whatever is behind it. The radius stays for
       a future wheel shot that is an opaque photo rather than line art. */
    border-radius: .25rem;
  }
  .wheel-card:hover {
    background: var(--stock2);
    transform: translateY(-2px);
    /* Light glow, not a dark shadow: a black shadow is invisible against the
       dark theme's near-black page background. */
    box-shadow: 0 8px 24px rgba(237,239,235,0.06);
  }
  .wheel-card:hover .wheel-image {
    transform: scale(1.05);
  }
  .wheel-card h2 {
    font-family: 'Barlow Condensed';
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .wheel-card .meta {
    font-family: 'IBM Plex Mono';
    font-size: .75rem;
    color: var(--soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .wheel-card .count {
    font-family: 'IBM Plex Mono';
    font-size: .8125rem;
    color: var(--ink);
    margin-top: .5rem;
  }
  .wheel-card a {
    display: inline-block;
    font-family: 'IBM Plex Mono';
    font-size: .71875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: .5625rem .875rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--stock);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: .75rem;
    text-align: center;
  }
  .wheel-card a:hover {
    background: var(--stock);
    color: var(--ink);
  }
  .empty-state {
    text-align: center;
    padding: 3.75rem 1.25rem;
  }
  .empty-state p {
    font-size: 1.125rem;
    color: var(--soft);
    margin: 1.25rem 0;
  }
</style>
</head>
<body>
<div class="sheet landing">
  <header class="masthead" style="width: 100%; max-width: 56.25rem; margin-bottom: 2.5rem;">
    <a class="logo" href="/" aria-label="WheelSourced home">
      <span class="word">Wheel<em>Sourced</em></span>
    </a>
  </header>

  <div class="landing-content">
    <!-- No wordmark hero. It repeated the masthead logo directly above it,
         and the brand name is the one term nobody searches for before they
         have heard of you. The h1 carries the page instead. -->
    <h1>Forged wheel factories, vetted and compared</h1>
    <!-- The methodology used to be printed here in full. It is real content
         and worth having, but it belongs on its own page rather than as a
         wall of prose on a deliberately sparse landing: a page of its own
         gets its own title and can answer "is flow formed the same as
         forged" directly, which body copy buried under a wordmark never
         would. Not hidden, moved. Hiding it with CSS would be the one
         version of this that risks the domain. -->
    <p class="lede">Every factory is asked the same questions at the same
      reference spec, and the answers are published as they were given.
      <a href="/methodology/">How the vetting works</a></p>
  </div>

  {wheels.length > 0 ? (
    <div class="wheels-grid">
      {wheels.map((wheel) => (
        <div class="wheel-card">
          {wheel.hasImage && (
            <img
              class="wheel-image"
              src={`/wheels/${wheel.slug}/image${wheel.imageExt}`}
              alt={wheel.title}
            />
          )}
          <h2>{wheel.title}<span style="font-size: 0.65em;">-style</span></h2>
          <div class="count">
            {wheel.suppliers.length} suppliers
          </div>
          <a href={`/${wheel.slug}/`}>View sourcing sheet</a>
        </div>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h2>No wheels yet</h2>
      <p>Add wheel data by running the pipeline and refresh this page.</p>
    </div>
  )}

  <div class="landing-content" style="margin-top: 5rem; margin-bottom: 2.5rem;">
    <p style="font-size: 1.125rem; color: var(--soft);">Don't see a wheel you're interested in?</p>
    <button onclick="document.getElementById('request-modal').style.display = 'flex'" style="display: inline-block; font-family: 'IBM Plex Mono'; font-size: .71875rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: .5625rem .875rem; border: 1px solid var(--ink); background: var(--ink); color: var(--stock); text-decoration: none; cursor: pointer; transition: all 0.2s;">Request here</button>
  </div>

  <div id="request-modal" class="modal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: none; align-items: center; justify-content: center; z-index: 1000;">
    <div class="modalbox" style="background: var(--stock); border: 2px solid var(--ink); padding: 2.5rem; max-width: 31.25rem; width: 90%;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="margin: 0; font-family: 'Barlow Condensed'; font-size: 1.5rem; font-weight: 700; text-transform: uppercase;">Request a wheel</h2>
        <button onclick="document.getElementById('request-modal').style.display = 'none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">×</button>
      </div>
      <form id="wheel-request-form" data-endpoint={REQUEST_ENDPOINT} onsubmit="submitWheelRequest(event)" style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label for="wheel-name" style="display: block; font-family: 'IBM Plex Mono'; font-size: .75rem; font-weight: 600; text-transform: uppercase; margin-bottom: .5rem;">Wheel name</label>
          <input id="wheel-name" type="text" placeholder="e.g., OZ Futura, Rotiform RSE" required style="width: 100%; padding: .5rem .75rem; border: 1px solid var(--ink); font-family: 'IBM Plex Mono'; font-size: .875rem; box-sizing: border-box;" />
        </div>
        <div style="display: flex; align-items: center; gap: .625rem;">
          <input id="wheel-alert-checkbox" type="checkbox" style="width: 1rem; height: 1rem; cursor: pointer;" />
          <label for="wheel-alert-checkbox" style="font-family: 'IBM Plex Mono'; font-size: .75rem; font-weight: 600; text-transform: uppercase; cursor: pointer; margin: 0;">Alert me</label>
        </div>
        <div id="wheel-email-field" style="display: none;">
          <label for="wheel-email" style="display: block; font-family: 'IBM Plex Mono'; font-size: .75rem; font-weight: 600; text-transform: uppercase; margin-bottom: .5rem;">Email</label>
          <input id="wheel-email" type="email" placeholder="you@example.com" style="width: 100%; padding: .5rem .75rem; border: 1px solid var(--ink); font-family: 'IBM Plex Mono'; font-size: .875rem; box-sizing: border-box;" />
          <div style="font-family: 'IBM Plex Mono'; font-size: .6875rem; color: var(--soft); margin-top: .375rem;">We'll alert you once we have vetted vendors for this wheel</div>
        </div>
        <div id="wheel-request-error" role="alert" style="display: none; font-family: 'IBM Plex Mono'; font-size: .71875rem; color: var(--chop); border: 1px solid var(--chop); padding: .5rem .625rem;"></div>
        <button type="submit" style="display: inline-block; font-family: 'IBM Plex Mono'; font-size: .71875rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: .5625rem .875rem; border: 1px solid var(--ink); background: var(--ink); color: var(--stock); cursor: pointer; transition: all 0.2s;">Submit request</button>
      </form>
    </div>
  </div>

  <div id="confirmation" style="position: fixed; top: 2.5rem; left: 50%; transform: translateX(-50%); background: var(--ink); color: var(--stock); padding: 1rem 1.5rem; border: 1px solid var(--ink); font-family: 'IBM Plex Mono'; font-size: .8125rem; display: none; z-index: 2000; max-width: 90%; text-align: center; animation: slideDown 0.3s ease-out;">
    Wheel request submitted
  </div>

  <footer style="margin-top: 7.5rem; padding: 2.5rem 1.25rem; border-top: 1px solid var(--ink); text-align: center; color: var(--soft);">
    <p style="font-family: 'IBM Plex Mono'; font-size: .6875rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 .75rem;">
      WheelSourced © 2026.
    </p>
    <p style="font-size: .8125rem; margin: 0; max-width: 37.5rem; margin-left: auto; margin-right: auto;">
      A curated sourcing site for aftermarket wheels made by Chinese factories.
    </p>
  </footer>

  <style>
    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateX(-50%) translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    }
  </style>
</div>

<script is:inline>
// The endpoint arrives on a data attribute rather than via define:vars.
// define:vars wraps the script in an IIFE, which puts every function in a
// closure, and the inline onsubmit="submitWheelRequest(event)" attribute
// resolves against global scope only. The handler became unreachable, the
// thrown ReferenceError meant preventDefault() never ran, and the form did a
// native GET submit: the page navigated and that looked exactly like success.
const el = (id) => document.getElementById(id);
const REQUEST_ENDPOINT = el("wheel-request-form").dataset.endpoint;

function showConfirmation() {
  const confirm = el("confirmation");
  confirm.style.display = "block";
  setTimeout(() => {
    confirm.style.display = "none";
  }, 3000);
}

function toggleEmailField() {
  const checkbox = el("wheel-alert-checkbox");
  const emailField = el("wheel-email-field");
  const emailInput = el("wheel-email");

  if (checkbox.checked) {
    emailField.style.display = "block";
    emailInput.focus();
  } else {
    emailField.style.display = "none";
    emailInput.value = "";
  }
}

async function submitWheelRequest(e) {
  e.preventDefault();
  const wheelName = el("wheel-name").value.trim();
  const email = el("wheel-email").value.trim();
  if (!wheelName) return;

  const btn = e.target.querySelector('button[type="submit"]');
  const label = btn ? btn.textContent : "";
  const err = el("wheel-request-error");
  err.style.display = "none";
  if (btn) { btn.textContent = "Sending..."; btn.disabled = true; }

  try {
    const response = await fetch(REQUEST_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name: wheelName, email: email || null })
    });
    if (!response.ok) throw new Error("Server returned " + response.status);

    el("wheel-name").value = "";
    el("wheel-email").value = "";
    el("wheel-alert-checkbox").checked = false;
    el("wheel-email-field").style.display = "none";
    el("request-modal").style.display = "none";
    showConfirmation();
  } catch (e2) {
    // A swallowed console.error left the modal open with no feedback, so a
    // failed request was indistinguishable from one that worked.
    err.textContent = "Could not send that request. Please try again.";
    err.style.display = "block";
  } finally {
    if (btn) { btn.textContent = label; btn.disabled = false; }
  }
}

el("wheel-alert-checkbox").addEventListener("change", toggleEmailField);
</script>
</body>
</html>
