---
import { loadWheels } from "../lib/data.js";
import "../styles/global.css";

const wheels = loadWheels();
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>WheelSourced</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
<style>
  .landing {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
  }
  .landing-content {
    max-width: 800px;
    text-align: center;
    margin-bottom: 60px;
  }
  .landing h1 {
    font-family: 'Barlow Condensed';
    font-size: clamp(48px, 10vw, 96px);
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .landing h1 em {
    font-style: normal;
    color: var(--bronze);
  }
  .landing p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--soft);
    margin: 0 0 40px;
  }
  .wheels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    max-width: 1200px;
    margin: 40px auto 0;
  }
  @media (max-width: 1024px) {
    .wheels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .wheels-grid {
      grid-template-columns: 1fr;
    }
  }
  .wheel-card {
    border: 2px solid var(--ink);
    padding: 32px 24px;
    background: transparent;
    transition: background var(--trans-smooth),transform var(--trans-smooth),box-shadow var(--trans-smooth);
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    text-align: center;
  }
  .wheel-image {
    width: 80px;
    height: 80px;
    object-fit: contain;
    margin-bottom: 12px;
    transition: transform var(--trans-smooth);
    background-color: var(--stock);
    border-radius: 4px;
  }
  .wheel-card:hover {
    background: var(--stock2);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  .wheel-card:hover .wheel-image {
    transform: scale(1.05);
  }
  .wheel-card h2 {
    font-family: 'Barlow Condensed';
    font-size: 28px;
    font-weight: 700;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .wheel-card .meta {
    font-family: 'IBM Plex Mono';
    font-size: 12px;
    color: var(--soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .wheel-card .count {
    font-family: 'IBM Plex Mono';
    font-size: 13px;
    color: var(--ink);
    margin-top: 8px;
  }
  .wheel-card a {
    display: inline-block;
    font-family: 'IBM Plex Mono';
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 9px 14px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--stock);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 12px;
    text-align: center;
  }
  .wheel-card a:hover {
    background: var(--stock);
    color: var(--ink);
  }
  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }
  .empty-state p {
    font-size: 18px;
    color: var(--soft);
    margin: 20px 0;
  }
</style>
</head>
<body>
<div class="sheet landing">
  <header class="masthead" style="width: 100%; max-width: 900px; margin-bottom: 40px;">
    <a class="logo" href="/" aria-label="WheelSourced home">
      <span class="word">Wheel<em>Sourced</em></span>
    </a>
  </header>

  <div class="landing-content">
    <h1>Wheel<em>Sourced</em></h1>
  </div>

  {wheels.length > 0 ? (
    <div class="wheels-grid">
      {wheels.map((wheel) => (
        <div class="wheel-card">
          {wheel.hasImage && (
            <img
              class="wheel-image"
              src={`/wheels/${wheel.slug}/image${wheel.imageExt}`}
              alt={wheel.title}
            />
          )}
          <h2>{wheel.title}<span style="font-size: 0.65em;">-style</span></h2>
          <div class="count">
            {wheel.suppliers.length} suppliers
          </div>
          <a href={`/${wheel.slug}/`}>View sourcing sheet</a>
        </div>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h2>No wheels yet</h2>
      <p>Add wheel data by running the pipeline and refresh this page.</p>
    </div>
  )}

  <div class="landing-content" style="margin-top: 80px; margin-bottom: 40px;">
    <p style="font-size: 18px; color: var(--soft);">Don't see a wheel you're interested in?</p>
    <button onclick="document.getElementById('request-modal').style.display = 'flex'" style="display: inline-block; font-family: 'IBM Plex Mono'; font-size: 11.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 9px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--stock); text-decoration: none; cursor: pointer; transition: all 0.2s;">Request here</button>
  </div>

  <div id="request-modal" class="modal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: none; align-items: center; justify-content: center; z-index: 1000;">
    <div class="modalbox" style="background: var(--stock); border: 2px solid var(--ink); padding: 40px; max-width: 500px; width: 90%;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="margin: 0; font-family: 'Barlow Condensed'; font-size: 24px; font-weight: 700; text-transform: uppercase;">Request a wheel</h2>
        <button onclick="document.getElementById('request-modal').style.display = 'none'" style="background: none; border: none; font-size: 24px; cursor: pointer;">×</button>
      </div>
      <form onsubmit="submitWheelRequest(event)" style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <label for="wheel-name" style="display: block; font-family: 'IBM Plex Mono'; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Wheel name</label>
          <input id="wheel-name" type="text" placeholder="e.g., OZ Futura, Rotiform RSE" required style="width: 100%; padding: 8px 12px; border: 1px solid var(--ink); font-family: 'IBM Plex Mono'; font-size: 14px; box-sizing: border-box;" />
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <input id="wheel-alert-checkbox" type="checkbox" style="width: 16px; height: 16px; cursor: pointer;" />
          <label for="wheel-alert-checkbox" style="font-family: 'IBM Plex Mono'; font-size: 12px; font-weight: 600; text-transform: uppercase; cursor: pointer; margin: 0;">Alert me</label>
        </div>
        <div id="wheel-email-field" style="display: none;">
          <label for="wheel-email" style="display: block; font-family: 'IBM Plex Mono'; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Email</label>
          <input id="wheel-email" type="email" placeholder="you@example.com" style="width: 100%; padding: 8px 12px; border: 1px solid var(--ink); font-family: 'IBM Plex Mono'; font-size: 14px; box-sizing: border-box;" />
          <div style="font-family: 'IBM Plex Mono'; font-size: 11px; color: var(--soft); margin-top: 6px;">We'll alert you once we have vetted vendors for this wheel</div>
        </div>
        <button type="submit" style="display: inline-block; font-family: 'IBM Plex Mono'; font-size: 11.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 9px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--stock); cursor: pointer; transition: all 0.2s;">Submit request</button>
      </form>
    </div>
  </div>

  <div id="confirmation" style="position: fixed; top: 40px; left: 50%; transform: translateX(-50%); background: var(--ink); color: var(--stock); padding: 16px 24px; border: 1px solid var(--ink); font-family: 'IBM Plex Mono'; font-size: 13px; display: none; z-index: 2000; max-width: 90%; text-align: center; animation: slideDown 0.3s ease-out;">
    Wheel request submitted
  </div>

  <footer style="margin-top: 120px; padding: 40px 20px; border-top: 1px solid var(--ink); text-align: center; color: var(--soft);">
    <p style="font-family: 'IBM Plex Mono'; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 12px;">
      WheelSourced
    </p>
    <p style="font-size: 13px; margin: 0 0 16px; max-width: 600px; margin-left: auto; margin-right: auto;">
      A curated sourcing site for aftermarket wheels made by Chinese factories. Not a link aggregator. The product is the vetting.
    </p>
    <p style="font-family: 'IBM Plex Mono'; font-size: 11px; margin: 0;">
      © 2026. Wheels, specs, and supplier data updated quarterly.
    </p>
  </footer>

  <style>
    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateX(-50%) translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    }
  </style>
</div>

<script is:inline>
const el = (id) => document.getElementById(id);

function showConfirmation() {
  const confirm = el("confirmation");
  confirm.style.display = "block";
  setTimeout(() => {
    confirm.style.display = "none";
  }, 3000);
}

function toggleEmailField() {
  const checkbox = el("wheel-alert-checkbox");
  const emailField = el("wheel-email-field");
  const emailInput = el("wheel-email");

  if (checkbox.checked) {
    emailField.style.display = "block";
    emailInput.focus();
  } else {
    emailField.style.display = "none";
    emailInput.value = "";
  }
}

async function submitWheelRequest(e) {
  e.preventDefault();
  const wheelName = el("wheel-name").value.trim();
  const email = el("wheel-email").value.trim();

  if (!wheelName) {
    return;
  }

  try {
    const response = await fetch("http://localhost:8420/api/request-wheel", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name: wheelName, email: email || null })
    });

    if (response.ok) {
      el("wheel-name").value = "";
      el("wheel-email").value = "";
      el("wheel-alert-checkbox").checked = false;
      el("wheel-email-field").style.display = "none";
      el("request-modal").style.display = "none";
      showConfirmation();
    }
  } catch (err) {
    console.error("Error submitting request:", err);
  }
}

el("wheel-alert-checkbox").addEventListener("change", toggleEmailField);
</script>
</body>
</html>
